#!/usr/bin/env bash
# Canonical Full ServeSID trainer; uses ONLY this checkout's sid_mlp package.
#
# From ServeSID/:
#   GRAPH_DIR=/data/cache MODEL_DIR=/data/teacher BEAM_DUMP=/data/beam.pt \
#     bash scripts/train.sh.servesid sidmlp Beauty 0
#
# Optional: ARCH=gru|cnn (default mlp), SEEDS="42 43 44", DATASET=...,
# CONFIG=..., TIGER_CKPT=..., SEM_IDS=..., DATASET_TAG=...,
# VAL_DATASET_TAG=..., VALID_SET=..., CKPT_DIR=..., LOG_DIR=....
# The script trains once per seed and creates best-Val checkpoints;
# it does not claim to reproduce historical GPU numbers automatically.
set -euo pipefail

SERVESID_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:-sidmlp}"
CATEGORY="${2:-${CATEGORY:-Beauty}}"
CUDA_DEVICE="${3:-${CUDA_DEVICE:-0}}"
ARCH="${ARCH:-mlp}"
SEEDS="${SEEDS:-42 43 44}"

if [[ "$MODE" != "sidmlp" ]]; then
  echo "This entrypoint trains Full ServeSID only (mode sidmlp)." >&2
  exit 2
fi
case "$ARCH" in mlp|gru|cnn) ;; *) echo "Unknown ARCH=$ARCH; use mlp, gru, or cnn" >&2; exit 2;; esac

: "${GRAPH_DIR:?Set GRAPH_DIR to the prepared encoder/cache directory}"
: "${MODEL_DIR:?Set MODEL_DIR to the teacher checkpoint/semantic-ID directory}"
: "${BEAM_DUMP:?Set BEAM_DUMP to the TRAIN-request teacher candidate dump}"

if [[ -z "${DATASET:-}" ]]; then
  if [[ "$CATEGORY" == "Video_Games" ]]; then
    DATASET="AmazonReviews2023"
  else
    DATASET="Amazon2014"
  fi
fi

CONFIG="${CONFIG:-$SERVESID_DIR/configs/servesid_final.yaml}"
TIGER_CKPT="${TIGER_CKPT:-${CHECKPOINT:-$MODEL_DIR/$CATEGORY/checkpoint.pth}}"
SEM_IDS="${SEM_IDS:-$MODEL_DIR/$CATEGORY/sem_ids.pt}"
DATASET_TAG="${DATASET_TAG:-${DATASET}_${CATEGORY}}"
VAL_DATASET_TAG="${VAL_DATASET_TAG:-${DATASET_TAG}_val}"
CKPT_DIR="${CKPT_DIR:-$GRAPH_DIR/ServeSID/ckpt}"
LOG_DIR="${LOG_DIR:-$GRAPH_DIR/ServeSID/logs}"

for path in "$CONFIG" "$TIGER_CKPT" "$SEM_IDS" "$BEAM_DUMP"; do
  if [[ ! -f "$path" ]]; then
    echo "Missing file: $path" >&2
    exit 3
  fi
done
[[ -d "$GRAPH_DIR" ]] || { echo "GRAPH_DIR is missing: $GRAPH_DIR" >&2; exit 3; }
# Absolute paths avoid ambiguity after changing the working directory.
CONFIG="$(realpath "$CONFIG")"
TIGER_CKPT="$(realpath "$TIGER_CKPT")"
SEM_IDS="$(realpath "$SEM_IDS")"
BEAM_DUMP="$(realpath "$BEAM_DUMP")"
GRAPH_DIR="$(realpath "$GRAPH_DIR")"
mkdir -p "$CKPT_DIR" "$LOG_DIR"
CKPT_DIR="$(realpath "$CKPT_DIR")"
LOG_DIR="$(realpath "$LOG_DIR")"

export PYTHONPATH="$SERVESID_DIR${PYTHONPATH:+:$PYTHONPATH}"
export CUDA_VISIBLE_DEVICES="$CUDA_DEVICE"
cd "$SERVESID_DIR"

extra_args=()
if [[ -n "${VALID_SET:-}" ]]; then
  extra_args=(--valid_set "$VALID_SET")
fi

for seed in $SEEDS; do
  case "$seed" in
    42|43|44) ;;
    *) echo "Unexpected seed $seed; paper protocol uses 42, 43, 44" >&2; exit 4 ;;
  esac
  tag="${RUN_TAG_PREFIX:-servesid_full}_${DATASET}_${CATEGORY}_${ARCH}_seed${seed}"
  echo "Full ServeSID: dataset=$DATASET category=$CATEGORY arch=$ARCH seed=$seed"
  python -m sid_mlp.cli.train sidmlp \
    --config "$CONFIG" --checkpoint "$TIGER_CKPT" \
    --dataset "$DATASET" --category "$CATEGORY" \
    --dataset_tag "$DATASET_TAG" --val_dataset_tag "$VAL_DATASET_TAG" \
    --sem_ids "$SEM_IDS" --graph_dir "$GRAPH_DIR" --beam_dump "$BEAM_DUMP" \
    --ckpt_dir "$CKPT_DIR" --log_dir "$LOG_DIR" \
    --arch "$ARCH" --seed "$seed" --run_tag "$tag" "${extra_args[@]}"
done

echo "Done. Use the *_best_val_ndcg10.pth checkpoint for evaluation."
